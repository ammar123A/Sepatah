# Copy to .env and fill in from Supabase → Project Settings → API. Restart `npm run dev` after editing.
# Anon/publishable key only. Never put the service role key here: it ends up in the browser bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Venue map in the admin form (Google Cloud Console → APIs & Services). This key is public in the bundle, so lock it down:
# Application restriction: HTTP referrers (your domain + http://localhost:5173/*).
# API restriction: Maps JavaScript API, Places API (New), Geocoding API. Set daily quotas as a cost cap.
VITE_GOOGLE_MAPS_KEY=YOUR-BROWSER-KEY
# Google Maps Platform → Map management → Create Map ID (JavaScript, Vector). Leave empty to use DEMO_MAP_ID while testing.
VITE_GOOGLE_MAP_ID=

# Copy to .env and fill in from Supabase → Project Settings → API. Restart `npm run dev` after editing.
# Anon/publishable key only. Never put the service role key here: it ends up in the browser bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
